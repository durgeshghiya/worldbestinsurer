{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "./**/*.ts",
    "../utils/robots-checker.ts",
    "../../src/lib/registry/**/*.ts",
    "../../src/lib/types.ts",
    "../../src/lib/removed-products.ts"
  ]
}
